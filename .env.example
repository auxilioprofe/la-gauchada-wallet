# Copiá este archivo a .env y completá los valores. NO subas .env al repo.

# ── Google Wallet ──────────────────────────────────────────
# JSON completo de la service account, en UNA sola línea.
GOOGLE_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com"}
# ID numérico del emisor (Consola de Google Wallet).
ISSUER_ID=
# ID de la clase de lealtad, con el formato <ISSUER_ID>.nombre_de_clase
CLASS_ID=

# ── Base de datos Turso ────────────────────────────────────
TURSO_URL=
TURSO_TOKEN=

# ── App ────────────────────────────────────────────────────
SESSION_SECRET=
PANEL_PASSWORD=
PORT=3000
